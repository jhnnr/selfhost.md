digraph NetworkTopology {
    // Global graph settings - Orthogonal 90-degree right angle routing
    graph [
        rankdir = "TB",
        splines = "ortho",
        compound = true,
        bgcolor = "#161f27",
        fontname = "Helvetica, Arial, sans-serif",
        fontsize = 12,
        nodesep = 0.65,
        ranksep = 0.75,
        pad = "0.4"
    ];

    // Global node styling
    node [
        shape = box,
        style = "rounded,filled",
        fillcolor = "#1e293b",
        color = "#38bdf8",
        penwidth = 1.5,
        fontname = "Helvetica, Arial, sans-serif",
        fontsize = 10,
        fontcolor = "#f8fafc",
        margin = "0.15,0.12"
    ];

    // Global edge styling
    edge [
        fontname = "Helvetica, Arial, sans-serif",
        fontsize = 9,
        fontcolor = "#94a3b8",
        color = "#64748b",
        penwidth = 1.2,
        arrowsize = 0.75
    ];

    // Sole top node: Public Internet
    wan [
        label = "Public Internet",
        shape = ellipse,
        fillcolor = "#0f172a",
        color = "#38bdf8",
        fontcolor = "#f8fafc"
    ];

    // Physical Network Path
    router [
        label = "Home ISP Router\n192.168.100.1/24 (br0)\nStatic Route: 10.10.0.0/24 via 192.168.100.2",
        fillcolor = "#1e293b",
        color = "#60a5fa"
    ];

    // Cloudflare Edge / Mesh
    cf_mesh [
        label = "Cloudflare Edge / Mesh\nSubnet: 100.96.0.0/12\nZero-Trust Ingress",
        fillcolor = "#1e293b",
        color = "#f97316"
    ];

    // Oracle Cloud VPS Node (connected via Cloudflare Mesh)
    vps_oracle [
        label = "Oracle Cloud VPS (openvpn-oracle)\nCloud Mesh Node\nRemote Access Point",
        fillcolor = "#1e293b",
        color = "#a855f7"
    ];

    // Proxmox VE Host Cluster (pve01)
    subgraph cluster_pve01 {
        label = "Proxmox Host (pve01)";
        fontcolor = "#e2e8f0";
        fontsize = 12;
        style = "filled";
        fillcolor = "#111827";
        color = "#0284c7";
        penwidth = 1.8;

        vmbr0 [
            label = "vmbr0 (Physical Bridge)\n192.168.100.2",
            fillcolor = "#334155",
            color = "#60a5fa"
        ];

        vmbr1 [
            label = "vmbr1 (NAT Gateway for 10.10.0.0/24)\n10.10.0.1 (GW)",
            fillcolor = "#334155",
            color = "#60a5fa"
        ];

        host_smb [
            label = "Host SMB Mount (/etc/fstab)\n/mnt/pve/smb-rclone.lan/Media",
            shape = folder,
            fillcolor = "#1e293b",
            color = "#eab308"
        ];
    }

    // Homelab Subnet Cluster (10.10.0.0/24)
    subgraph cluster_homelab {
        label = "10.10.0.0/24 Subnet (DHCP & DNS via 10.10.0.2)";
        fontcolor = "#e2e8f0";
        fontsize = 12;
        style = "dashed";
        color = "#0284c7";
        bgcolor = "#0b1118";

        // Ingress via Cloudflare Tunnel
        ct101 [
            label = "[CT 101] cloudflared.lan\n10.10.0.3 (Static)\nForwards DoH & Tunnel Traffic to 10.10.0.0/24",
            fillcolor = "#1e293b",
            color = "#f97316"
        ];

        // DNS & DHCP Server
        ct100 [
            label = "[CT 100] adguard.lan\n10.10.0.2 (Static / adguard.home.server)\nPrimary DNS (:53) | DHCP Server | Web UI (:3000)",
            fillcolor = "#1e293b",
            color = "#22c55e"
        ];

        // Shared PostgreSQL Server
        ct106 [
            label = "[CT 106] postgresql.lan (DHCP)\nShared PostgreSQL (:5432) & Adminer (:80/adminer)\nDatabases: openkos, firefly",
            fillcolor = "#1e293b",
            color = "#a855f7"
        ];

        // Dedicated Docker Host VM - Flat list of hosted projects without categorization
        vm102 [
            label = "[VM 102] docker.lan (DHCP) [16GB RAM]\nHosted Projects:\n- OpenKOS\n- Firefly III\n- PodPDF\n- Steam-ish\n- Portainer",
            fillcolor = "#1e293b",
            color = "#38bdf8"
        ];

        // Storage Controller
        ct103 [
            label = "[CT 103] rclone.lan (DHCP)\nRclone FUSE (/mnt/gdrive/plex, /mnt/tas)\nSamba Server (//rclone.lan/gdrive)",
            fillcolor = "#1e293b",
            color = "#eab308"
        ];

        // Media Playback Server
        ct104 [
            label = "[CT 104] plex.lan (DHCP)\nPlex Media Server (:32400)\nMovies: Section 2 | TV Shows: Section 3",
            fillcolor = "#1e293b",
            color = "#ec4899"
        ];

        // Download Client
        ct105 [
            label = "[CT 105] qbit.lan (DHCP)\nqBittorrent WebUI (:8090, Bearer Auth)\nSave Path: /downloads/tv-sonarr\nHook: discord_qbit_notification.sh",
            fillcolor = "#1e293b",
            color = "#06b6d4"
        ];

        // TV Automation
        sonarr [
            label = "sonarr.lan (LXC)\nTV Automation (:8989)\nLibrary: /mnt/media/TV\nPost-Import Hook: qbit-relocate.sh",
            fillcolor = "#1e293b",
            color = "#14b8a6"
        ];

        // Movie Automation
        ct109 [
            label = "[CT 109] radarr.lan (DHCP)\nMovie Automation (:7878)\nLibrary: /mnt/media/Movies",
            fillcolor = "#1e293b",
            color = "#f59e0b"
        ];

        // Indexer Management
        ct110 [
            label = "[CT 110] prowlarr.lan (DHCP)\nIndexer Manager & Proxy (:9696)\nSync: Sonarr & Radarr",
            fillcolor = "#1e293b",
            color = "#3b82f6"
        ];

        // Subtitle Automation
        ct111 [
            label = "[CT 111] bazarr.lan (DHCP)\nSubtitle Management (:6767)\nSync: Sonarr & Radarr",
            fillcolor = "#1e293b",
            color = "#10b981"
        ];

        // Media Discovery & Requests
        seer [
            label = "seer.lan (LXC)\nJellyseerr / Overseerr (:5055)\nMedia Discovery & Requests",
            fillcolor = "#1e293b",
            color = "#8b5cf6"
        ];
    }

    // Top-Level Ingress Routing
    // Only Public Internet at the top
    wan -> router [color = "#60a5fa"];
    wan -> cf_mesh [color = "#f97316"];

    // Home ISP router is the ONLY link connected to vmbr0
    router -> vmbr0 [color = "#60a5fa"];

    // Oracle Cloud VPS connects through Cloudflare Edge / Mesh
    cf_mesh -> vps_oracle [color = "#a855f7"];

    // Cloudflare Edge / Mesh connects directly through cloudflared.lan
    cf_mesh -> ct101 [color = "#f97316", penwidth = 1.5];

    // Proxmox Internal NAT Bridge
    vmbr0 -> vmbr1 [color = "#60a5fa"];

    // Subnet Distribution from Gateway
    vmbr1 -> ct100;
    vmbr1 -> ct101;
    vmbr1 -> ct106;
    vmbr1 -> vm102;
    vmbr1 -> ct103;
    vmbr1 -> ct104;
    vmbr1 -> ct105;
    vmbr1 -> sonarr;
    vmbr1 -> ct109;
    vmbr1 -> ct110;
    vmbr1 -> ct111;
    vmbr1 -> seer;

    // Database Connection from Docker VM to PostgreSQL
    vm102 -> ct106 [color = "#a855f7"];

    // Storage Pipeline (Samba Share -> Host Mount -> LXC Bind Mounts)
    ct103 -> host_smb [style = "dashed", color = "#eab308"];
    host_smb -> ct104 [color = "#ec4899", penwidth = 1.6];
    host_smb -> ct105 [color = "#06b6d4", penwidth = 1.6];
    host_smb -> ct109 [color = "#f59e0b", penwidth = 1.6];
    host_smb -> ct111 [color = "#10b981", penwidth = 1.6];

    // Media Automation Pipeline Interconnects
    seer -> sonarr [color = "#14b8a6"];
    seer -> ct109 [color = "#f59e0b"];
    seer -> ct104 [color = "#8b5cf6"];
    ct110 -> sonarr [color = "#3b82f6"];
    ct110 -> ct109 [color = "#3b82f6"];
    sonarr -> ct105 [color = "#06b6d4"];
    ct109 -> ct105 [color = "#06b6d4"];
    sonarr -> ct111 [color = "#10b981"];
    ct109 -> ct111 [color = "#10b981"];
    ct105 -> ct104 [style = "dotted", color = "#ec4899"];
}
